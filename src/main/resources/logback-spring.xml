<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- stdout belongs to the MCP stdio transport, so all logs go to stderr. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- One JSON object per line. Ship this file to your SIEM. -->
  <appender name="AUDIT" class="ch.qos.logback.core.FileAppender">
    <file>${KAFKA_OPS_AUDIT_FILE:-kafka-ops-audit.jsonl}</file>
    <append>true</append>
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <logger name="kafka_ops.audit" level="INFO" additivity="false">
    <appender-ref ref="AUDIT"/>
  </logger>
  <logger name="org.apache.kafka" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
